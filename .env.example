# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to git!
# ─────────────────────────────────────────────

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Maps Places API (optional - requires billing)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SerpAPI (optional - 100 free searches/month at serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Gmail SMTP
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Social Media APIs (all optional) ─────────────────────────────────────────
# Instagram via Apify (paid) or instagrapi (free)
APIFY_TOKEN=your_apify_token_here
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Facebook Pages API — free at developers.facebook.com
FACEBOOK_ACCESS_TOKEN=your_facebook_token_here

# RapidAPI — covers LinkedIn, TikTok, Twitter/X scrapers (free tier)
# Sign up at: rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube Data API v3 — free, enable in Google Cloud (same project as Sheets)
YOUTUBE_API_KEY=your_youtube_api_key_here
